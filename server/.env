NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bian
# Use a long random value in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
UPLOAD_DIR=uploads
# Where `npm run db:export` / `db:import` keep the database export (relative to server/)
DB_DATA_DIR=../db/data
# On start, fill an empty database from DB_DATA_DIR, or with sample data if there is no export (true/false)
AUTO_INIT_DB=true
MAX_UPLOAD_MB=20
# New registrations need admin approval (true/false)
REQUIRE_APPROVAL=true
# Members must verify their email before signing in (true/false)
REQUIRE_EMAIL_VERIFICATION=true
# Optional seed passwords
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=

# ---- Email (verification, password reset, sign-in codes)
# Leave EMAIL_ENABLED=false until you have a mailbox: emails are then written to the server log,
# and in development the links/codes are also shown on screen.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BIAN <no-reply@example.com>"

# ---- Sign-in codes: after the password, email a 6-digit code that must be entered (true/false)
LOGIN_OTP_ENABLED=false
LOGIN_OTP_MINUTES=10

# ---- Developer console account (feature switches). Created on start if it doesn't exist.
# Not a role: it never appears in Roles & Permissions or the member lists. Use a strong password.
DEVELOPER_EMAIL=developer@bian.local
DEVELOPER_PASSWORD=BianDev2026
