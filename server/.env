NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bian
# Use a long random value in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
# New registrations need admin approval (true/false)
REQUIRE_APPROVAL=true
# Members must verify their email before signing in (true/false)
REQUIRE_EMAIL_VERIFICATION=true
# Optional seed passwords
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=
